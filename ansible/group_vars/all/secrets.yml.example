# Copy this to secrets.yml in the same directory. This value is now shared
# across host groups (Postgres uses it for appuser's password, Icinga2 uses
# it to run authenticated checks against appdb) - moved out of
# postgres_hosts/ specifically because Icinga2 lives on a different host
# and needs to see the same value.
# secrets.yml is gitignored - never commit it, sanitized or not.

app_db_password: "<password>"

# Not really a "secret," but kept out of a public GitHub repo anyway to
# avoid publishing an email address for spam bots to scrape. Used by
# certbot for Let's Encrypt expiry notices.
certbot_email: "<your-email>"
